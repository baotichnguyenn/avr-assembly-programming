.section .data
 
array: .byte 7,5,2,9,8
array_len: .byte 5

.section .text
.global asm_function

asm_function:
	ldi r18, lo8(array)
	push r18
	ldi r18, hi8(array)
	push r18
	lds r18, array_len
	push r18
	call list_iteration
	pop r18
	pop r18
	pop r18
	ret

list_iteration:
	in r30, 0x3d	;;Z -> SP
	in r31, 0x3e
	ldd r20, Z+3 	;; r20 stores array_len
	ldd r29, Z+4	;; Y points to array[0]
	ldd r28, Z+5
	clr r23		;; r23 = i

iterator:
	cp r23, r20
	brsh iterator_done
	ld r19, Y
	push r19
	call recursive_oddeven	;; call recursive func
	pop r19			;; getting recursive result
	st Y+, r19		;; replace value inplace
	inc r23
	rjmp iterator

recursive_oddeven:
	in r30, 0x3d	;;Z -> SP
	in r31, 0x3e
	ldd r21, Z+3
	cpi r21, 0 
	brne recurse
	ret

recurse: 
	mov r22, r21
	dec r22
	push r22
	call recursive_oddeven
	pop r19 
	in r30, 0x3d	;;Z -> SP
	in r31, 0x3e
	ldd r24, Z+3

	ldi r25, 1
	sbrs r24, 0
	ldi r25, 2
	
	add r19 , r24
	add r19 , r25
	std Z+3, r19 
	ret
	

iterator_done:
	ret	

ret

.end